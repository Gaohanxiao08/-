# ============================================================
# 中国政策过程多智能体计算模拟平台 — 环境变量示例
# 复制为 .env 后按需填写（.env 已被 .gitignore 忽略）
# ============================================================

# DeepSeek API Key（服务端兜底密钥）
# 页面中也可以为每个 Agent 单独配置 API Key，优先于该环境变量
DEEPSEEK_API_KEY=

# 前端默认 API Key（可选，会写入浏览器 localStorage，注意泄露风险）
NEXT_PUBLIC_DEEPSEEK_API_KEY=

# 服务启动配置
HOSTNAME=localhost
PORT=3000
COZE_PROJECT_ENV=DEV
